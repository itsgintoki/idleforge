{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noEmitOnError": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}

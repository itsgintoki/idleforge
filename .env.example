# Local development settings matching compose.yaml. Copy to .env.
PORT=3000
DATABASE_URL=postgresql://idleforge:idleforge_local@127.0.0.1:5434/idleforge

# Generate a random secret as described in README.md; do not commit .env.
JWT_SECRET=

REDIS_URL=redis://127.0.0.1:6384
QUEUE_PREFIX=idleforge

# Operational tuning (defaults shown).
BONUS_BATCH_SIZE=1000
PURCHASE_COMMAND_RETENTION_DAYS=30
WORLD_EVENT_STALE_RESERVATION_HOURS=24
REFRESH_TOKEN_TTL_DAYS=30
METRICS_PORT=9464

# Optional OpenTelemetry tracing. Leave unset to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=idleforge-api
